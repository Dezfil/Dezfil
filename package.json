{
  "name": "dezfil",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Self-hosted spatial SQL and map publishing, powered by DuckDB and files",
  "homepage": "https://dezfil.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dezfil/Dezfil"
  },
  "bugs": {
    "url": "https://github.com/Dezfil/Dezfil/issues"
  },
  "keywords": [
    "gis",
    "duckdb",
    "deck-gl",
    "maplibre",
    "geoparquet",
    "pmtiles",
    "self-hosted",
    "spatial-sql",
    "mcp"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --import=./scripts/ingress-preload.mjs ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --import=./scripts/ingress-preload.mjs ./node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "lint:hygiene": "node scripts/check-nul-bytes.mjs",
    "lint:citations": "node scripts/check-internal-citations.mjs",
    "lint:readme": "node scripts/check-readme-config.mjs",
    "lint:size": "node scripts/check-monster-files.mjs",
    "lint:stage-edge": "node scripts/check-stage-edge.mjs",
    "lint:wheelhouse": "node scripts/check-wheelhouse.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "lint:icons": "node scripts/check-inline-svg.mjs",
    "lint:specimen": "node scripts/build-specimen.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "journey:browser": "playwright test",
    "admin:recover": "node scripts/admin-recover.mjs",
    "journey:recovery": "node scripts/recovery-journey.mjs",
    "probe:settings": "node scripts/settings-probe.mjs",
    "probe:query-result-budget": "node scripts/query-result-budget-probe.mjs",
    "probe:body": "node scripts/body-probe.mjs",
    "probe:transport": "node scripts/transport-probe.mjs",
    "probe:gate": "node scripts/gate-journey.mjs",
    "probe:login": "node scripts/login-http-probe.mjs",
    "probe:published-auth": "node scripts/published-auth-probe.mjs",
    "e2e:keyboard": "playwright test e2e/keyboard-journey.spec.ts e2e/keyboard-interactions.spec.ts e2e/a11y-census.spec.ts",
    "e2e:a11y-pixels": "playwright test e2e/a11y-resting-pixels.spec.ts",
    "e2e:layers": "playwright test e2e/layer-matrix-1.spec.ts e2e/layer-matrix-2.spec.ts",
    "e2e:imports": "playwright test e2e/import-matrix-1.spec.ts e2e/import-matrix-2.spec.ts",
    "e2e:sqlbridge": "playwright test e2e/sql-result-layer.spec.ts",
    "e2e:sqlconsole": "playwright test e2e/sql-console.spec.ts",
    "e2e:draw": "playwright test e2e/draw-on-map.spec.ts",
    "e2e:styling": "playwright test e2e/styling-legend-3d.spec.ts",
    "e2e:recovery": "playwright test e2e/recovery-controls.spec.ts",
    "e2e:lifecycle": "playwright test e2e/publish-lifecycle.spec.ts",
    "e2e:theme": "playwright test e2e/published-theme.spec.ts",
    "e2e:states": "playwright test e2e/empty-error-states.spec.ts",
    "e2e:pixel": "playwright test e2e/pixel-regressions.spec.ts",
    "e2e:statepixels": "playwright test e2e/state-unification-pixels.spec.ts",
    "e2e:wheelhousepixels": "playwright test e2e/wheelhouse-pixels.spec.ts",
    "e2e:primitives": "playwright test e2e/primitive-contracts.spec.ts",
    "e2e:smoke": "DEZFIL_E2E_ASSISTANT=1 playwright test e2e/assistant-confirmation-smoke.spec.ts",
    "e2e:look": "playwright test e2e/appearance.spec.ts",
    "lint:plugin": "node scripts/generate-dezfil-guidance.mjs --check",
    "lint:contract-docs": "node scripts/check-contract-docs.mjs",
    "lint:reader-docs": "node scripts/check-reader-docs.mjs",
    "probe:publication-source": "node scripts/publication-source-probe.mjs",
    "probe:derivation": "node scripts/derivation-probe.mjs",
    "probe:credential-cleanup": "node scripts/credential-cleanup-driver.mjs",
    "e2e:result-budget": "playwright test e2e/query-result-budget.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@deck.gl/aggregation-layers": "9.4.0",
    "@deck.gl/core": "9.4.0",
    "@deck.gl/extensions": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "@deck.gl/react": "9.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@duckdb/node-api": "^1.5.4-r.1",
    "@lezer/highlight": "^1.2.3",
    "@maplibre/maplibre-gl-style-spec": "^24.10.0",
    "@modelcontextprotocol/server": "^2.0.0-beta.2",
    "@xyflow/react": "^12.11.3",
    "better-sqlite3": "^12.11.1",
    "busboy": "^1.6.0",
    "fast-xml-parser": "^5.10.1",
    "html-to-image": "^1.11.13",
    "maplibre-gl": "6.11.2",
    "next": "^16.3.8",
    "openai": "^6.45.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "pmtiles": "^4.4.1",
    "puppeteer-core": "^25.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "supercluster": "^8.0.1",
    "uuid": "^14.0.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@balena/dockerignore": "1.0.2",
    "@mapbox/maki": "^8.2.0",
    "@mapbox/vector-tile": "^2.0.5",
    "@modelcontextprotocol/client": "^2.0.0-beta.2",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supercluster": "^7.1.3",
    "@types/yazl": "^3.3.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.8",
    "jszip": "^3.10.1",
    "pbf": "^4.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@deck.gl/mesh-layers": "9.4.0",
    "@deck.gl/widgets": "9.4.0"
  }
}
